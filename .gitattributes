* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
gradlew text eol=lf

*.png binary
*.gif binary
*.ogg binary
*.nbt binary
*.jar binary
*.zip binary

# Keep shipped resource bytes unchanged on every platform.
src/main/resources/** -text whitespace=cr-at-eol
src/main/templates/** -text whitespace=cr-at-eol
